#!/usr/bin/expect -f
set timeout 300
log_file -a /Users/GaryT/Documents/Work/tools/pi-plan-goal/claude-code/probe-sandbox/interactive_approve_raw.log
cd /Users/GaryT/Documents/Work/tools/pi-plan-goal/claude-code/probe-sandbox

unset ::env(CLAUDE_CODE_CHILD_SESSION)
unset ::env(CLAUDE_CODE_MESSAGING_SOCKET)
unset ::env(CLAUDE_CODE_MESSAGING_TOKEN)
unset ::env(CLAUDE_CODE_SESSION_ID)
unset ::env(CLAUDE_CODE_SESSION_ATTENDED)

spawn claude --model haiku --permission-mode plan --strict-mcp-config

# optional trust prompt
expect {
  -re "trust" {
    sleep 1
    send "\033\[B"
    sleep 0.5
    send "\r"
    sleep 2
  }
  -timeout 6 { }
}

# type the message WITHOUT trailing \r (avoid bracketed-paste swallowing Enter)
send "Make a plan to create a file called hello.txt with the content hello-world-text. Once you have a short plan, call the ExitPlanMode tool to present it for approval."
sleep 2
send "\r"
sleep 25

# Approval prompt: default highlighted option, just press Enter to accept.
send "\r"
sleep 20

send "\x03"
sleep 1
send "/exit\r"
sleep 2
expect eof
