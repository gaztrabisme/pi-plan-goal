#!/usr/bin/expect -f
set timeout 300
log_file -a /Users/GaryT/Documents/Work/tools/pi-plan-goal/claude-code/probe-sandbox/interactive_stopB_raw.log
cd /Users/GaryT/Documents/Work/tools/pi-plan-goal/claude-code/probe-sandbox

unset ::env(CLAUDE_CODE_CHILD_SESSION)
unset ::env(CLAUDE_CODE_MESSAGING_SOCKET)
unset ::env(CLAUDE_CODE_MESSAGING_TOKEN)
unset ::env(CLAUDE_CODE_SESSION_ID)
unset ::env(CLAUDE_CODE_SESSION_ATTENDED)
set ::env(STOP_VARIANT) B

spawn claude --model haiku --strict-mcp-config

expect {
  -re "trust" {
    sleep 1
    send "\033\[B"
    sleep 0.5
    send "\r"
    sleep 2
  }
  -timeout 6 { }
}

send "Say hi in one short sentence, nothing else."
sleep 2
send "\r"
sleep 20

send "\x03"
sleep 1
send "/exit\r"
sleep 2
expect eof
